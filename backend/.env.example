# Copia este archivo a .env (o define las variables en tu plataforma). No subir valores reales.
# Con el pooler de Supabase en modo transacción puede requerirse ?prepareThreshold=0 en la URL.
DB_URL=jdbc:postgresql://<host>:<puerto>/postgres
DB_USER=app_sgi
DB_PASSWORD=
# Clave HS256 de al menos 32 caracteres
JWT_SECRET=
# Orígenes del frontend separados por coma (por defecto http://localhost:3000)
CORS_ORIGENES=http://localhost:3000
# Solo para el perfil "seed" (crear o actualizar el Administrador inicial)
ADMIN_DNI=
ADMIN_PASSWORD=
ADMIN_NOMBRES=
ADMIN_APELLIDO_PATERNO=
